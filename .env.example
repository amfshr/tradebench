# Copy to .env (gitignored) and fill in. SINGLE-QUOTE the password — '$' expands otherwise.
# TRADEBENCH_IG_ENV pins this machine to ONE environment; only that IG_<ENV>_* set is read.
TRADEBENCH_IG_ENV='demo'
TRADEBENCH_INSTANCE='capture-demo-01'
# The user every row this instance writes belongs to — the platform tier's owner (D31).
TRADEBENCH_USER='platform'
TRADEBENCH_EPICS='IX.D.DAX.DAILY.IP'

# Sink: 'db' is the real write path (compose-managed local Postgres: docker compose up -d postgres);
# 'jsonl' writes local capture files instead (then set TRADEBENCH_CAPTURE_DIR).
TRADEBENCH_SINK='db'
TRADEBENCH_DB_URL='jdbc:postgresql://localhost:5435/market_data'
TRADEBENCH_DB_USER='tradebench'
TRADEBENCH_DB_PASSWORD='changeme'
#TRADEBENCH_DB_PORT='5435'
#TRADEBENCH_CAPTURE_DIR='/Users/you/tradebench-capture'

# The daily archive's bucket (any S3-protocol store; chosen at E1-T7). All five or none: with none the
# daily job heals only and nothing is archived off the box; with some, the service refuses to start.
#TRADEBENCH_ARCHIVE_ENDPOINT='https://<account>.r2.cloudflarestorage.com'
#TRADEBENCH_ARCHIVE_REGION='auto'
#TRADEBENCH_ARCHIVE_BUCKET='changeme'
#TRADEBENCH_ARCHIVE_ACCESS_KEY_ID='changeme'
#TRADEBENCH_ARCHIVE_SECRET_ACCESS_KEY='changeme'

IG_DEMO_IDENTIFIER='changeme'
IG_DEMO_PASSWORD='changeme'
IG_DEMO_API_KEY='changeme'
IG_DEMO_ACCOUNT_ID='changeme'
