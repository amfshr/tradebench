# /etc/tradebench/market-data.env on the box (0600). Placeholders only — the real file never enters git (G1).
TRADEBENCH_IG_ENV='demo'
TRADEBENCH_INSTANCE='changeme'
TRADEBENCH_USER='platform'
TRADEBENCH_EPICS='IX.D.DAX.DAILY.IP'
TRADEBENCH_SINK='db'
# The DML-only app role runs the service; the owner role runs Flyway (deploy/postgres/roles.sql).
TRADEBENCH_DB_URL='jdbc:postgresql://postgres:5432/market_data'
TRADEBENCH_DB_USER='market_data_app'
TRADEBENCH_DB_PASSWORD='changeme'
TRADEBENCH_DB_MIGRATE_USER='market_data_owner'
TRADEBENCH_DB_MIGRATE_PASSWORD='changeme'
IG_DEMO_IDENTIFIER='changeme'
IG_DEMO_PASSWORD='changeme'
IG_DEMO_API_KEY='changeme'
IG_DEMO_ACCOUNT_ID='changeme'
# The archive's bucket (D34 R3: Cloudflare R2).
TRADEBENCH_ARCHIVE_ENDPOINT='https://<account>.r2.cloudflarestorage.com'
TRADEBENCH_ARCHIVE_REGION='auto'
TRADEBENCH_ARCHIVE_BUCKET='changeme'
TRADEBENCH_ARCHIVE_ACCESS_KEY_ID='changeme'
TRADEBENCH_ARCHIVE_SECRET_ACCESS_KEY='changeme'
# The dead-man ping (D33): healthchecks.io's ping URL for this check.
TRADEBENCH_PING_URL='https://hc-ping.com/changeme'
# Telemetry (D33, D34 R9): Grafana Cloud's EU OTLP endpoint and its basic-auth header.
OTEL_EXPORTER_OTLP_ENDPOINT='https://otlp-gateway-prod-eu-west-2.grafana.net/otlp'
OTEL_EXPORTER_OTLP_PROTOCOL='http/protobuf'
OTEL_EXPORTER_OTLP_HEADERS='Authorization=Basic changeme'
OTEL_SERVICE_NAME='market-data-service'
OTEL_RESOURCE_ATTRIBUTES='deployment.environment=production' # service.instance.id is added from TRADEBENCH_INSTANCE
OTEL_TRACES_EXPORTER='none'
