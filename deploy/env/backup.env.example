# /etc/tradebench/backup.env on the box (0600). rclone reads its remote from these — no config file holds them.
RCLONE_CONFIG_R2_TYPE='s3'
RCLONE_CONFIG_R2_PROVIDER='Cloudflare'
RCLONE_CONFIG_R2_ACCESS_KEY_ID='changeme'
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY='changeme'
RCLONE_CONFIG_R2_ENDPOINT='https://<account>.r2.cloudflarestorage.com'
# A token scoped to one bucket cannot check that the bucket exists; without this, rclone's check is refused.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET='true'
# The archive's bucket: the dumps go under dumps/, the archive under platform/ — one bucket, one token.
TRADEBENCH_BACKUP_BUCKET='changeme'
# Optional: a second healthchecks.io check, pinged after each successful dump — its silence alarms a missed backup.
TRADEBENCH_BACKUP_PING_URL=''
