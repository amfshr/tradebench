# /etc/tradebench/postgres.env on the box (0600). Read by the Postgres container; the three role passwords
# are used once, at the volume's first start (deploy/postgres/init-roles.sh).
POSTGRES_PASSWORD='changeme'
TRADEBENCH_DB_OWNER_PASSWORD='changeme'
TRADEBENCH_DB_APP_PASSWORD='changeme'
TRADEBENCH_DB_READER_PASSWORD='changeme'
