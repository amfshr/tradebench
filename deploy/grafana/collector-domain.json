{
  "uid": "tradebench-collector-domain",
  "title": "Collector — domain",
  "description": "What the collector captured, per market and user, and what the heal did with the gaps (E1-T16). Trends only: the record views live in the platform app (D25 R3).",
  "tags": [
    "tradebench",
    "collector",
    "domain"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prom",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "regex": "/-prom$/"
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "regex": "/-logs$/"
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "query": {
          "query": "label_values(jvm_thread_count{job=\"market-data-service\"}, instance)",
          "refId": "i"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {},
        "hide": 0
      },
      {
        "name": "market",
        "label": "Market",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "query": {
          "query": "label_values(tradebench_capture_ticks_total, market)",
          "refId": "m"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {},
        "hide": 0
      },
      {
        "name": "user",
        "label": "User",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prom}"
        },
        "query": {
          "query": "label_values(tradebench_capture_ticks_total, user)",
          "refId": "u"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Captured",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Ticks per hour, by market and user",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (market, user) (increase(tradebench_capture_ticks_total{instance=~\"$instance\",market=~\"$market\",user=~\"$user\"}[1h]))",
          "legendFormat": "{{market}} · {{user}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Bars per hour, by market and user",
      "description": "60 an hour when the market trades every minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (market, user) (increase(tradebench_capture_bars_total{instance=~\"$instance\",market=~\"$market\",user=~\"$user\"}[1h]))",
          "legendFormat": "{{market}} · {{user}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Gaps and the heal",
      "id": 4,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Missing minutes found, by origin",
      "description": "'stream' is the detector, live; 'heal' is the nightly check. Never add them together — they can be the same minutes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (origin) (increase(tradebench_gap_minutes_total{instance=~\"$instance\",market=~\"$market\",user=~\"$user\"}[1d]))",
          "legendFormat": "{{origin}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Minutes the heal looked for, by outcome",
      "description": "'healed' came from IG's history; 'absent_at_source' means IG has no candle either — the market did not trade.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (outcome) (increase(tradebench_heal_minutes_total{instance=~\"$instance\",market=~\"$market\",user=~\"$user\"}[1d]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "IG history points: the heal's spend and the account's balance",
      "description": "The balance is the account's — anything else on the same IG key draws it too.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum(increase(tradebench_heal_points_spent_total{instance=~\"$instance\",market=~\"$market\",user=~\"$user\"}[1d]))",
          "legendFormat": "spent by the heal (per day)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "max(tradebench_ig_allowance_remaining{instance=~\"$instance\"})",
          "legendFormat": "account remaining"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Daily job runs, by job and outcome",
      "description": "A missing day of runs is the alarm (D30).",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (job_name, outcome) (increase(tradebench_jobs_runs_total{instance=~\"$instance\",market=~\"$market\",user=~\"$user\"}[1d]))",
          "legendFormat": "{{job_name}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Job run time, 95th percentile",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, job_name) (rate(tradebench_jobs_duration_seconds_bucket{instance=~\"$instance\"}[1d])))",
          "legendFormat": "{{job_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Daily job lines",
      "description": "One line per heal and archive run, with its detail.",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{service_name=\"market-data-service\"} |= \"jobs: \"",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 7
      }
    },
    {
      "type": "row",
      "title": "Market rhythm — the evidence beside B24",
      "id": 11,
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "heatmap",
      "title": "Time between ticks, by hour",
      "description": "Seconds of IG time between consecutive ticks. Thin overnight trade shows as the long tail.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "sum by (le) (increase(tradebench_capture_tick_gap_seconds_bucket{instance=~\"$instance\",market=~\"$market\",user=~\"$user\"}[$__interval]))",
          "legendFormat": "{{le}}",
          "format": "heatmap"
        }
      ],
      "options": {
        "calculate": false,
        "yAxis": {
          "unit": "s"
        },
        "cellGap": 1,
        "color": {
          "scheme": "Oranges",
          "mode": "scheme"
        }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 16,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Tick gap percentiles",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${prom}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(tradebench_capture_tick_gap_seconds_bucket{instance=~\"$instance\",market=~\"$market\",user=~\"$user\"}[1h])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${prom}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(tradebench_capture_tick_gap_seconds_bucket{instance=~\"$instance\",market=~\"$market\",user=~\"$user\"}[1h])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 16,
        "y": 34,
        "w": 8,
        "h": 9
      }
    }
  ]
}
